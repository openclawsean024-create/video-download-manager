# Multi-stage Dockerfile for the Video Download Manager
# Stage 1: build frontend
FROM node:22-alpine AS web-builder
WORKDIR /app/web
COPY client/package*.json ./
RUN npm install --no-audit --no-fund
COPY client/ ./
RUN npm run build

# Stage 2: build backend
FROM node:22-alpine AS server-builder
WORKDIR /app
COPY server/package*.json ./
RUN npm install --no-audit --no-fund
COPY server/ ./
RUN npm run build

# Stage 3: production runtime
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app

# Backend
COPY --from=server-builder /app/dist ./server/dist
COPY --from=server-builder /app/node_modules ./server/node_modules
COPY --from=server-builder /app/package.json ./server/package.json

# Frontend static files (we'll serve via vite preview for simplicity)
COPY --from=web-builder /app/web/dist ./client/dist

# Persistence dirs
RUN mkdir -p /app/server/data /app/server/downloads /app/client
VOLUME ["/app/server/data", "/app/server/downloads"]

EXPOSE 4000 5173

# Default: run backend, then preview client
CMD ["sh", "-c", "node server/dist/index.js & npx --prefix client vite preview --host 0.0.0.0 --port 5173"]